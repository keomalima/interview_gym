  "referenceCode": "export function searchRotated(nums,target) {\n  let l=0,r=nums.length-1;\n  while(l<=r){const m=Math.floor((l+r)/2);if(nums[m]===target)return m;\n    if(nums[l]<=nums[m]) { if(nums[l]<=target&&target<nums[m])r=m-1;else l=m+1; }\n    else { if(nums[m]<target&&target<=nums[r])l=m+1;else r=m-1; }\n  }\n  return -1;\n}\n"
}
