  "referenceCode": "export function searchInsertPosition(numbers, target) {\n    let left = 0, right = numbers.length;\n    while (left < right) {\n        const mid = Math.floor((left + right) / 2);\n        if (numbers[mid] < target)\n            left = mid + 1;\n        else\n            right = mid;\n    }\n    return left;\n}\n"
}
