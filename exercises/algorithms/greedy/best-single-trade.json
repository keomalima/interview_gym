  "referenceCode": "export function maxSingleTradeProfit(prices) {\n  let lowest = Infinity, best = 0;\n  for (const price of prices) { best = Math.max(best, price - lowest); lowest = Math.min(lowest, price); }\n  return best;\n}\n"
