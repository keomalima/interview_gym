  "referenceCode": "export function minIntervalsToRemove(intervals) {\n  const sorted=intervals.map(x=>x.slice()).sort((a,b)=>a[1]-b[1]);\n  let lastEnd=-Infinity,kept=0;\n  for(const [s,e] of sorted)if(s>=lastEnd){lastEnd=e;kept++;}\n  return intervals.length-kept;\n}\n"
}
