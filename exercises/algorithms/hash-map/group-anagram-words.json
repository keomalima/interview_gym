  "referenceCode": "export function groupAnagramWords(words) {\n  const m=new Map();\n  for(const w of words){const key=[...w].sort().join('');if(!m.has(key))m.set(key,[]);m.get(key).push(w);}\n  return [...m.values()];\n}\n"
