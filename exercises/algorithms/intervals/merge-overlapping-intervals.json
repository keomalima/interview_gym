  "requirements": [
    "Each interval is [start, end], with integer start <= end.",
    "Merge intervals whenever the next start is <= the current end (touching endpoints count as overlapping).",
    "Return intervals sorted by start ascending.",
    "Return [] for no intervals and do not mutate the input."
  ],
  "starterCode": "export function mergeOverlappingIntervals(intervals) {\n  // Sort a copy before scanning.\n  return [];\n}\n",
