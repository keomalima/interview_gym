  "prerequisites": [],
  "summary": "Fix an off-by-one loop that skips the first element of the list.",
  "durationMinutes": 15,
  "functionName": "indexOfFirstMatch",
  "requirements": [
    "Return the zero-based first index matching target via strict equality.",
    "Return -1 when absent.",
    "Do not change the input."
  ],
  "starterCode": "export function indexOfFirstMatch(items, target) {\n  for (let i = 1; i < items.length; i++) {\n    if (items[i] === target) return i;\n  }\n  return -1;\n}\n",
  "hints": [
    "Inspect where the loop starts.",
    "Index zero is also a valid match."
  ],
  "examples": [
    {
      "label": "Typical case",
      "input": [
        [
          4,
          5,
          6
        ],
        4
      ],
      "output": 0
    },
    {
      "label": "Alternative case",
      "input": [
        [
          4,
          5,
          6
        ],
        6
      ],
      "output": 2
    }
  ],
  "tests": [
    {
      "name": "Common case — [[4,5,6],4]",
      "input": [
        [
          4,
          5,
          6
        ],
        4
      ],
      "expected": 0
    },
    {
      "name": "Alternative scenario — [[4,5,6],6]",
