      ],
      "expected": 2
    },
    {
      "name": "Boundary condition — [[4,5,6],7]",
      "input": [
        [
          4,
          5,
          6
        ],
        7
      ],
      "expected": -1
    },
    {
      "name": "Edge case — [[],1]",
