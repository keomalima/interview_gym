{
  "schemaVersion": 1,
  "id": "debug-inclusive-date-range",
  "title": "Debug inclusive day-range filtering",
  "eyebrow": "JavaScript · debugging",
  "category": "practical",
  "language": "javascript",
  "difficulty": "easy",
  "topics": [
    "debugging",
