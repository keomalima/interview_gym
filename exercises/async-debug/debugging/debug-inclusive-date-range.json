  "exerciseType": "function",
  "prerequisites": [],
  "summary": "A report filter should include records from both endpoints of a requested date range. Repair the final-day boundary so events on the end date are not dropped. Fix a date-range filter that excludes records on the final day.",
  "durationMinutes": 15,
  "functionName": "filterInclusiveDates",
  "requirements": [
    "Dates are valid zero-padded YYYY-MM-DD strings.",
    "Include both from and to bounds.",
    "Preserve original record order."
  ],
  "starterCode": "export function filterInclusiveDates(records, from, to) {\n  return records.filter(r => r.date >= from && r.date < to);\n}\n",
  "hints": [
    "Lexicographic comparison works for zero-padded ISO dates.",
    "The upper bound must be inclusive, not strictly less than."
  ],
  "examples": [
    {
      "label": "Typical case",
      "input": [
        [
          {
            "date": "2026-01-01",
            "id": 1
          },
          {
            "date": "2026-01-02",
            "id": 2
          }
        ],
        "2026-01-01",
        "2026-01-02"
      ],
      "output": [
        {
          "date": "2026-01-01",
          "id": 1
        },
        {
          "date": "2026-01-02",
          "id": 2
        }
      ]
    },
    {
      "label": "Alternative case",
      "input": [
        [],
        "2026-01-01",
        "2026-01-10"
      ],
      "output": []
    }
  ],
  "tests": [
    {
      "name": "Common case — [[{\"date\":\"2026-01-01\",\"id\":1},{\"date\":\"2026-01-02\",\"id\":2}],\"2026-0…",
      "input": [
        [
          {
            "date": "2026-01-01",
            "id": 1
          },
          {
            "date": "2026-01-02",
            "id": 2
          }
        ],
        "2026-01-01",
        "2026-01-02"
      ],
      "expected": [
        {
          "date": "2026-01-01",
          "id": 1
        },
        {
          "date": "2026-01-02",
          "id": 2
        }
      ]
    },
    {
      "name": "Alternative scenario — [[],\"2026-01-01\",\"2026-01-10\"]",
      "input": [
        [],
        "2026-01-01",
        "2026-01-10"
      ],
      "expected": []
    },
    {
      "name": "Boundary condition — [[{\"date\":\"2026-01-02\",\"id\":1}],\"2026-01-02\",\"2026-01-02\"]",
      "input": [
        [
          {
            "date": "2026-01-02",
            "id": 1
          }
        ],
        "2026-01-02",
        "2026-01-02"
      ],
      "expected": [
        {
          "date": "2026-01-02",
          "id": 1
        }
      ]
    },
    {
      "name": "Edge case — [[{\"date\":\"2026-02-01\",\"id\":1}],\"2026-01-01\",\"2026-01-31\"]",
      "input": [
        [
          {
            "date": "2026-02-01",
            "id": 1
          }
        ],
        "2026-01-01",
        "2026-01-31"
      ],
      "expected": []
    },
    {
      "name": "Additional variation — [[{\"date\":\"2025-12-31\",\"id\":1},{\"date\":\"2026-01-01\",\"id\":2}],\"2026-0…",
      "input": [
        [
          {
            "date": "2025-12-31",
            "id": 1
          },
          {
            "date": "2026-01-01",
            "id": 2
          }
        ],
        "2026-01-01",
        "2026-02-01"
      ],
      "expected": [
        {
          "date": "2026-01-01",
          "id": 2
        }
      ]
    }
  ],
  "referenceCode": "export function filterInclusiveDates(records, from, to) {\n    return records.filter(r => r.date >= from && r.date <= to);\n}\n"
}
