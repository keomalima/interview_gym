{
  "schemaVersion": 1,
  "id": "debug-pagination-off-by-one",
  "title": "Debug a one-based pagination function",
  "eyebrow": "JavaScript · debugging",
  "category": "practical",
  "language": "javascript",
  "difficulty": "easy",
  "topics": [
    "debugging",
