{
  "schemaVersion": 1,
  "id": "debug-preserve-zero-values",
  "title": "Debug a filter losing valid zero values",
  "eyebrow": "JavaScript · debugging",
  "category": "practical",
  "language": "javascript",
  "difficulty": "easy",
  "topics": [
    "debugging",
