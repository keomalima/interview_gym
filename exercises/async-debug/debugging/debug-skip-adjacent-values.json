  "starterCode": "export function collapseAdjacent(nums) {\n  for (let i = 0; i < nums.length; i++) {\n    if (nums[i] === nums[i + 1]) nums.splice(i, 1);\n  }\n  return nums;\n}\n",
  "hints": [
    "Removing items during forward iteration can skip the next element.",
    "Build a new result rather than splicing the source during traversal."
  ],
