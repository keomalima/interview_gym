  "prerequisites": [],
  "summary": "A report ranks numeric amounts, but string-style sorting puts values such as 100 before 20. Correct the comparator so the result follows numeric order. Fix a sorting function that orders numbers lexicographically.",
  "durationMinutes": 15,
  "functionName": "sortNumericAmounts",
  "requirements": [
    "Sort in numerical ascending order.",
    "Keep duplicates.",
    "Return a new array without mutating the input."
  ],
  "starterCode": "export function sortNumericAmounts(amounts) {\n  return amounts.sort();\n}\n",
  "hints": [
    "Default Array.sort compares strings.",
    "Provide a comparator and sort a copy."
  ],
  "examples": [
    {
      "label": "Typical case",
      "input": [
        [
          2,
          10,
          1
        ]
      ],
      "output": [
        1,
        2,
        10
      ]
    },
    {
      "label": "Alternative case",
      "input": [
        []
      ],
      "output": []
    }
  ],
  "tests": [
    {
      "name": "Common case — [[2,10,1]]",
      "input": [
        [
          2,
          10,
          1
        ]
      ],
      "expected": [
        1,
        2,
        10
      ]
    },
    {
      "name": "Alternative scenario — [[]]",
      "input": [
        []
      ],
      "expected": []
    },
    {
      "name": "Boundary condition — [[-2,-10,0]]",
      "input": [
        [
          -2,
          -10,
          0
        ]
      ],
      "expected": [
        -10,
        -2,
        0
      ]
    },
    {
      "name": "Edge case — [[4,4,2]]",
      "input": [
        [
          4,
          4,
          2
        ]
      ],
      "expected": [
        2,
        4,
        4
      ]
    },
    {
      "name": "Additional variation — [[100,20,3]]",
      "input": [
        [
          100,
          20,
          3
        ]
      ],
      "expected": [
        3,
        20,
        100
      ]
    }
  ],
  "referenceCode": "export function sortNumericAmounts(amounts) { return [...amounts].sort((a, b) => a - b); }\n"
}
