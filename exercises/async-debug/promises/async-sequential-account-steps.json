  "starterCode": "export async function applyAsyncBalanceSteps(initial: number, steps: { type: \"add\" | \"subtract\"; amount: number }[]) {\n  // Implement the behavior described in the brief.\n  throw new Error(\"Not implemented\");\n}\n",
