  ],
  "starterCode": "export async function applyAsyncStockUpdates(initial: Record<string, number>, changes: { sku: string; delta: number }[]) {\n  // Implement the behavior described in the brief.\n  throw new Error(\"Not implemented\");\n}\n",
  "hints": [
    "Clone the initial inventory before changes.",
    "Await each change before applying its delta."
  ],
  "examples": [
