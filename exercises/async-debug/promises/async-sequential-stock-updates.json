  "tests": [
    {
      "name": "Common case — [{\"a\":5},[{\"sku\":\"a\",\"delta\":-2},{\"sku\":\"b\",\"delta\":3}]]",
      "input": [
        {
          "a": 5
        },
        [
          {
            "sku": "a",
            "delta": -2
          },
          {
