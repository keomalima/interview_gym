    {
      "name": "Additional variation — [{\"a\":1,\"b\":2},[{\"sku\":\"b\",\"delta\":5},{\"sku\":\"a\",\"delta\":1}]]",
      "input": [
        {
          "a": 1,
          "b": 2
        },
        [
          {
            "sku": "b",
            "delta": 5
          },
          {
            "sku": "a",
            "delta": 1
          }
        ]
      ],
      "expected": {
        "a": 2,
        "b": 7
      }
