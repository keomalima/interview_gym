{
  "schemaVersion": 1,
  "id": "async-settle-result-list",
  "title": "Collect fulfilled and rejected job outcomes",
  "eyebrow": "TypeScript · promises",
  "category": "practical",
  "language": "typescript",
  "difficulty": "medium",
  "topics": [
    "promises",
