  "referenceCode": "export function formatSeconds(total) {\n  const h=Math.floor(total/3600),m=Math.floor(total%3600/60),s=total%60;\n  return [h,m,s].map(n=>String(n).padStart(2,'0')).join(':');\n}\n"
