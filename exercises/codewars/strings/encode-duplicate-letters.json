  "referenceCode": "export function encodeDuplicates(text) {\n  const s=text.toLowerCase(),m=new Map();for(const c of s)m.set(c,(m.get(c)||0)+1);\n  return [...s].map(c=>m.get(c)>1?')':'(').join('');\n}\n"
