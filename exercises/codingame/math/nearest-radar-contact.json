  "referenceCode": "export function nearestRadarPoint(points) {\n  if(!points.length)return null;let best=null,min=Infinity;\n  for(const p of points){const d=p.x*p.x+p.y*p.y;if(d<min){best=p.id;min=d;}}\n  return best;\n}\n"
