          [
            "html",
            "text/html"
          ]
        ],
        "index.html"
      ],
      "output": "text/html"
    }
  ],
  "tests": [
    {
      "name": "Common case — [[[\"html\",\"text/html\"],[\"png\",\"image/png\"]],\"Photo.PNG\"]",
      "input": [
        [
          [
            "html",
            "text/html"
          ],
          [
            "png",
            "image/png"
          ]
        ],
        "Photo.PNG"
      ],
      "expected": "image/png"
    },
    {
      "name": "Alternative scenario — [[[\"html\",\"text/html\"]],\"index.html\"]",
      "input": [
        [
          [
            "html",
            "text/html"
          ]
        ],
        "index.html"
      ],
      "expected": "text/html"
    },
    {
      "name": "Boundary condition — [[[\"jpg\",\"image/jpeg\"]],\"file\"]",
      "input": [
        [
          [
            "jpg",
            "image/jpeg"
          ]
        ],
        "file"
      ],
      "expected": "UNKNOWN"
    },
    {
      "name": "Edge case — [[[\"gz\",\"application/gzip\"]],\"archive.tar.gz\"]",
      "input": [
        [
          [
            "gz",
            "application/gzip"
          ]
        ],
        "archive.tar.gz"
      ],
      "expected": "application/gzip"
    },
    {
      "name": "Additional variation — [[[\"txt\",\"text/plain\"]],\"note.\"]",
      "input": [
        [
          [
            "txt",
            "text/plain"
          ]
        ],
        "note."
      ],
      "expected": "UNKNOWN"
    }
  ],
  "referenceCode": "export function lookupMime(entries, filename) {\n    const dot = filename.lastIndexOf('.');\n    if (dot < 0 || dot === filename.length - 1)\n        return 'UNKNOWN';\n    const ext = filename.slice(dot + 1).toLowerCase();\n    for (const [key, mime] of entries)\n        if (key.toLowerCase() === ext)\n            return mime;\n    return 'UNKNOWN';\n}\n"
}
