  "summary": "Identify the MIME type of a filename from a configurable extension table.",
  "durationMinutes": 20,
  "functionName": "lookupMime",
  "requirements": [
    "Match extension names case-insensitively.",
    "Only the segment after the last dot determines the extension.",
    "Return UNKNOWN if no valid extension or match exists."
  ],
  "starterCode": "export function lookupMime(entries,filename) {\n  // Implement the behavior described in the brief.\n  throw new Error(\"Not implemented\");\n}\n",
  "hints": [
