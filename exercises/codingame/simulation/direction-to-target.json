  "summary": "Return a compass movement that moves one step toward a target on a grid.",
  "durationMinutes": 15,
  "functionName": "directionToTarget",
  "requirements": [
    "Y increases downward and X increases to the right.",
    "Use N/S before E/W in diagonal names.",
    "Return STAY if already at the target."
  ],
  "starterCode": "export function directionToTarget(x,y,tx,ty) {\n  // Implement the behavior described in the brief.\n  throw new Error(\"Not implemented\");\n}\n",
  "hints": [
    "Compare current and target coordinates independently.",
    "Concatenate vertical and horizontal direction codes."
  ],
  "examples": [
    {
      "label": "Typical case",
      "input": [
        0,
        0,
        2,
        3
      ],
      "output": "SE"
    },
    {
      "label": "Alternative case",
      "input": [
        2,
        3,
        0,
        0
      ],
      "output": "NW"
    }
  ],
  "tests": [
    {
      "name": "Common case — [0,0,2,3]",
      "input": [
        0,
        0,
        2,
        3
      ],
      "expected": "SE"
    },
    {
      "name": "Alternative scenario — [2,3,0,0]",
      "input": [
        2,
        3,
        0,
        0
      ],
      "expected": "NW"
    },
    {
      "name": "Boundary condition — [0,0,0,0]",
      "input": [
        0,
        0,
        0,
        0
      ],
      "expected": "STAY"
    },
    {
      "name": "Edge case — [5,5,5,3]",
      "input": [
        5,
        5,
        5,
        3
      ],
      "expected": "N"
    },
    {
      "name": "Additional variation — [4,4,6,4]",
      "input": [
        4,
        4,
        6,
        4
      ],
      "expected": "E"
    }
  ],
  "referenceCode": "export function directionToTarget(x,y,tx,ty) {\n  const vertical=ty<y?'N':ty>y?'S':'';const horizontal=tx<x?'W':tx>x?'E':'';\n  return vertical+horizontal||'STAY';\n}\n"
}
