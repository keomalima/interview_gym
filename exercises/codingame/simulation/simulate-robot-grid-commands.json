    "Update one coordinate for each command."
  ],
  "examples": [
    {
      "label": "Typical case",
      "input": [
        0,
        0,
        "NNESW"
      ],
      "output": {
        "x": 0,
        "y": -1
      }
    },
    {
      "label": "Alternative case",
      "input": [
        3,
        4,
        ""
      ],
      "output": {
        "x": 3,
        "y": 4
      }
    }
  ],
  "tests": [
    {
      "name": "Common case — [0,0,\"NNESW\"]",
      "input": [
        0,
        0,
        "NNESW"
      ],
      "expected": {
        "x": 0,
        "y": -1
      }
    },
    {
      "name": "Alternative scenario — [3,4,\"\"]",
      "input": [
        3,
        4,
        ""
      ],
      "expected": {
        "x": 3,
        "y": 4
      }
    },
    {
      "name": "Boundary condition — [0,0,\"EESS\"]",
      "input": [
        0,
        0,
        "EESS"
      ],
      "expected": {
        "x": 2,
        "y": 2
      }
    },
    {
      "name": "Edge case — [1,1,\"WN\"]",
      "input": [
        1,
        1,
        "WN"
      ],
      "expected": {
        "x": 0,
        "y": 0
      }
    },
    {
      "name": "Additional variation — [-2,-2,\"SSW\"]",
      "input": [
        -2,
        -2,
        "SSW"
      ],
      "expected": {
        "x": -3,
        "y": 0
      }
    },
    {
      "name": "Rejects unknown movement",
      "input": [
        0,
        0,
        "XZ"
      ],
      "error": "Invalid direction"
    }
  ],
  "referenceCode": "export function executeRobotMoves(x, y, commands) {\n    for (const c of commands) {\n        if (c === 'N')\n            y--;\n        else if (c === 'S')\n            y++;\n        else if (c === 'E')\n            x++;\n        else if (c === 'W')\n            x--;\n        else\n            throw new Error('Invalid direction');\n    }\n    return { x, y };\n}\n"
}
