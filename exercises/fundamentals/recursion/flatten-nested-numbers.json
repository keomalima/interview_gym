  "summary": "Flatten an arbitrarily nested JSON array of numbers while preserving their left-to-right order.",
  "durationMinutes": 20,
  "functionName": "flattenNestedNumbers",
  "requirements": [
    "Input is an array containing finite numbers or nested arrays of the same kind.",
    "Return one flat array of numbers in their original traversal order.",
    "Handle empty arrays and any nesting depth supported by the runtime.",
    "Do not mutate the input.",
    "Do not use Array.prototype.flat(Infinity)."
  ],
  "starterCode": "export function flattenNestedNumbers(items) {\n  // Visit nested arrays recursively.\n  return [];\n}\n",
  "hints": [
    "An element is either a number to collect or an array to visit.",
    "Use a helper that walks each array and appends numbers to one output array.",
    "Recurse into arrays before continuing with the remaining siblings."
  ],
  "examples": [
