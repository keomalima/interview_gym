  "referenceCode": "export function groupEventsBySession(events: { sessionId: string; type: string }[]) {\n  const map=new Map();for(const e of events){if(!map.has(e.sessionId))map.set(e.sessionId,[]);map.get(e.sessionId).push(e.type);}\n  return [...map].map(([sessionId,types])=>({sessionId,types}));\n}\n"
