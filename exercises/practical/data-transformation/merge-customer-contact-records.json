  "referenceCode": "export function mergeCustomerContacts(records: { email: string; name: string; phone: string }[]) {\n  const m=new Map();for(const r of records){const email=r.email.trim().toLowerCase();if(!m.has(email))m.set(email,{email,name:r.name.trim(),phone:r.phone||''});\n    else{const current=m.get(email);if(!current.name&&r.name.trim())current.name=r.name.trim();if(!current.phone&&r.phone)current.phone=r.phone;}}\n  return [...m.values()];\n}\n"
