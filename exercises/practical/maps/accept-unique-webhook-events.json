  "referenceCode": "export function acceptWebhookEvents(events: {\n    id: string;\n    type: string;\n}[]) {\n    const seen = new Set(), accepted = [];\n    for (const e of events) {\n        if (seen.has(e.id))\n            continue;\n        seen.add(e.id);\n        accepted.push(e);\n    }\n    return accepted;\n}\n"
}
