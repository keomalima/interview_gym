  "referenceCode": "export function resolveFeatureFlags(defaults: Record<string, unknown>, overrides: Record<string, unknown>, allowed: string[]) {\n  const result={};for(const key of Object.keys(defaults).sort()){result[key]=allowed.includes(key)&&Object.hasOwn(overrides,key)?Boolean(overrides[key]):Boolean(defaults[key]);}return result;\n}\n"
