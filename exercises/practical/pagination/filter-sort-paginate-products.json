  "referenceCode": "export function listProducts(products: { id: string; category: string; priceCents: number }[], options: {category?: string; minPrice?: number; page?: number; pageSize?: number}) {\n  const {category='',minPrice=0,page=1,pageSize=10}=options;\n  const matching=products.filter(p=>(!category||p.category===category)&&p.priceCents>=minPrice).sort((a,b)=>a.priceCents-b.priceCents||a.id.localeCompare(b.id));\n  const start=(page-1)*pageSize;\n  return {total:matching.length,items:matching.slice(start,start+pageSize)};\n}\n"
