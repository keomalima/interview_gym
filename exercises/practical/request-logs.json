  "referenceCode": "type RequestLog = { requestId: string; timestamp: string; route: string; status: number; latencyMs: number };\ntype RouteSummary = { route: string; count: number; errorRatePercent: number; p95Ms: number };\n\nexport function summarizeRequests(logs: RequestLog[]): RouteSummary[] {\n  const latest = new Map<string, RequestLog>();\n  for (const log of logs) {\n    const previous = latest.get(log.requestId);\n    if (!previous || log.timestamp >= previous.timestamp) latest.set(log.requestId, log);\n  }\n  const grouped = new Map<string, RequestLog[]>();\n  for (const log of latest.values()) {\n    if (!Number.isInteger(log.status) || log.status < 100 || log.status > 599 || !Number.isFinite(log.latencyMs) || log.latencyMs < 0) continue;\n    const route = log.route.split('?')[0];\n    grouped.set(route, [...(grouped.get(route) ?? []), log]);\n  }\n  return [...grouped].sort(([a], [b]) => a.localeCompare(b)).map(([route, entries]) => {\n    const latencies = entries.map(x => x.latencyMs).sort((a, b) => a - b);\n    const errors = entries.filter(x => x.status >= 500).length;\n    return { route, count: entries.length, errorRatePercent: Math.round(errors / entries.length * 1000) / 10, p95Ms: latencies[Math.ceil(entries.length * 0.95) - 1] };\n  });\n}\n",
