  "referenceCode": "export function allocateStock(stock: Record<string, number>, orders: { id: string; sku: string; quantity: number }[]) {\n  const available={...stock},results=[];\n  for(const o of orders){const remaining=available[o.sku]??0;if(o.quantity>0&&remaining>=o.quantity){available[o.sku]=remaining-o.quantity;results.push({id:o.id,accepted:true});}\n    else results.push({id:o.id,accepted:false});}\n  return {remaining:available,results};\n}\n"
}
