  "tests": [
    {
      "name": "Common case — [{\"name\":\" Alice  Smith \",\"email\":\" ALICE@example.COM \"}]",
      "input": [
        {
          "name": " Alice  Smith ",
          "email": " ALICE@example.COM "
        }
      ],
      "expected": {
        "ok": true,
        "value": {
          "name": "Alice Smith",
          "email": "alice@example.com"
        }
      }
    },
    {
      "name": "Alternative scenario — [{\"name\":\" A \",\"email\":\"bad\"}]",
      "input": [
        {
          "name": " A ",
          "email": "bad"
        }
      ],
      "expected": {
        "ok": false,
        "errors": [
          "name",
          "email"
        ]
      }
    },
    {
