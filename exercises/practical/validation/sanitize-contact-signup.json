        ]
      }
    },
    {
      "name": "Additional variation — [{\"name\":\"Ok\",\"email\":\"invalid@\"}]",
      "input": [
        {
          "name": "Ok",
          "email": "invalid@"
        }
      ],
      "expected": {
        "ok": false,
        "errors": [
          "email"
        ]
      }
    }
  ],
  "referenceCode": "export function sanitizeSignup(payload: { name: unknown; email: unknown }) {\n  const name=typeof payload.name==='string'?payload.name.trim().replace(/\\s+/g,' '):'';\n  const email=typeof payload.email==='string'?payload.email.trim().toLowerCase():'';\n  const errors=[];if(name.length<2)errors.push('name');if(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email))errors.push('email');\n  return errors.length?{ok:false,errors}:{ok:true,value:{name,email}};\n}\n"
}
